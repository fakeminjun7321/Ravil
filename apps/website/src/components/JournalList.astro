---
import Icon from './Icon.astro';
import { stories } from '../data/stories';
interface Props { home?: boolean }
const { home = false } = Astro.props;
---
<section class:list={['journal-list',home&&'container section']}><div class="section-header"><div><span class="eyebrow">RAVIL JOURNAL</span><h2>{home?'RAVIL이 생각하는 공부.':'기능 뒤의 생각들.'}</h2><p class="section-description">원본을 확인하고, 기록을 남기고, 다시 이어가는 방식.</p></div>{home&&<a class="text-link" href="/updates/">개발 소식 모두 보기<Icon name="arrow" size={17}/></a>}</div><div class="journal-entry-list">{stories.map(story=><a class="journal-entry" href={`/journal/${story.slug}/`}><span class="journal-entry-number">{story.number}</span><div><span class="journal-entry-category">{story.category} · 2026.10.01</span><h3>{story.title}</h3><p>{story.summary}</p></div><span class="journal-entry-action">글 읽기<Icon name="arrow" size={20}/></span></a>)}</div></section>
