---
import '../styles/workspace.css';
import '../styles/auth.css';
import '../styles/note-editor.css';
import '../styles/studio-workspace.css';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#f6f6f2" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="RAVIL" />
    <meta name="robots" content="noindex" />
    <link rel="manifest" href="/workspace.webmanifest" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/workspace-icon-256.png" />
    <title>내 작업 · RAVIL</title>
  </head>
  <body class="studio-workspace">
    <a class="skip" href="#editor">본문으로 이동</a>
    <div id="workspace"><p class="loading">내 기록을 불러오는 중…</p></div>
    <dialog id="modal"><form method="dialog"><button class="close" aria-label="닫기">×</button></form><div id="modal-body"></div></dialog>
    <div id="notice" role="status" aria-live="polite"></div>
    <input id="note-media-input" type="file" accept="image/png,image/jpeg,image/webp,application/pdf" multiple hidden />
    <input id="note-import-input" type="file" accept=".md,.markdown,.txt,text/plain,text/markdown" hidden />
    <script>import '../workspace/app.ts';</script>
  </body>
</html>
