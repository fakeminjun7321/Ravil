---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import OCRExample from '../components/OCRExample.astro';
const chapters = [
  {id:'capture',label:'자유롭게 기록',title:'생각이 떠오를 때,\n그대로 남기세요.',body:'일상의 메모, 읽은 문장, 아이디어와 계획을 같은 공간에 남깁니다. 주제나 프로젝트를 먼저 정하지 않아도 시작할 수 있어요.',items:['제목 없이 본문부터 적기','사진·PDF를 원본 파일과 함께 보관하기','메모·노트·계획·활동을 구분해 살펴보기']},
  {id:'analysis',label:'AI 분석과 정리',title:'원문 옆에서,\n생각을 정리해요.',body:'AI가 기록의 핵심과 주제를 추리고, 관련 기록의 연결 이유와 다음 행동을 제안합니다. 직접 쓴 원문과 AI의 해석을 함께 확인할 수 있어요.',items:['핵심 요약과 주제 제안 확인하기','내가 선택한 태그만 반영하기','원문을 고치면 이전 분석과 현재 기록 구분하기']},
  {id:'connections',label:'주제와 프로젝트',title:'하나의 기록을,\n여러 맥락에서.',body:'사진집 아이디어를 개인 프로젝트와 관심 주제에서 함께 볼 수 있어요. 기록을 복사하는 대신 연결을 더하고, 필요할 때 연결을 바꿉니다.',items:['주제·프로젝트를 선택해서 연결하기','같은 프로젝트에 쌓인 기록 이어 읽기','분류되지 않은 기록도 전체 기록에서 찾기']},
  {id:'find',label:'검색과 질문',title:'쌓인 기록에서,\n필요한 생각을 다시.',body:'제목·본문·태그와 연결한 주제·프로젝트로 검색합니다. 기록에 질문하면 관련 내용과 근거를 함께 살펴볼 수 있어요.',items:['프로젝트 이름과 AI가 정리한 내용으로 찾기','질문의 답변에서 근거 기록 열기','기록에 없는 내용은 근거 부족으로 확인하기']},
  {id:'next',label:'다음 행동',title:'좋은 생각을,\n해볼 수 있는 일로.',body:'AI가 제안한 행동은 확인한 뒤 할 일로 더합니다. 날짜와 예상 시간을 직접 정하고, 진행하면서 기록을 이어갈 수 있어요.',items:['선택한 제안만 할 일로 추가하기','날짜·반복 횟수와 진행 상태 유지하기','작업 기록을 바탕으로 예상 시간 조정하기']},
  {id:'backup',label:'보관과 백업',title:'프로젝트가 끝나도,\n내 기록은 남도록.',body:'필요한 프로젝트를 백업하고 내려받은 파일을 검사한 뒤 보관합니다. 기록은 전체 기록과 이전 프로젝트 이름으로 다시 찾을 수 있어요.',items:['기록과 연결 파일을 포함한 백업 만들기','백업 이후 변경과 누락 확인하기','보관한 프로젝트의 원문 다시 찾아보기']}
];
---
<Layout title="기능 — RAVIL" description="자유 기록, AI 분석·정리, 주제와 프로젝트, 근거가 있는 질문, 다음 행동과 백업. RAVIL 개인용 세컨드 브레인의 사용 흐름을 살펴보세요.">
  <div class="container feature-page">
    <header class="feature-page-heading"><span class="eyebrow">INSIDE RAVIL</span><h1>내가 남긴 기록이,<br />다음 생각과 행동으로.</h1><p>RAVIL은 기록을 AI와 함께 이해하고 다시 활용하는<br class="desktop-break" /> 개인용 세컨드 브레인 워크스페이스를 만들고 있어요.</p><span class="feature-page-status">개발·검증 중 · AI 사용 범위는 연결 환경에 따라 달라요</span></header>
    <nav class="feature-chapters" aria-label="기능 목차">{chapters.map((chapter,index)=><a href={`#${chapter.id}`}><span>{String(index+1).padStart(2,'0')}</span>{chapter.label}</a>)}</nav>
    {chapters.map((chapter,index)=><section class="feature-chapter" id={chapter.id}><div class="chapter-intro"><span class="eyebrow">{String(index+1).padStart(2,'0')} · {chapter.label}</span><h2 style="white-space:pre-line">{chapter.title}</h2><p>{chapter.body}</p></div><div class="chapter-side"><ul class="feature-bullets">{chapter.items.map(item=><li>{item}</li>)}</ul>{index===0&&<div class="note-showcase"><span class="example-label">설명용 기록 예제</span><h3>사진집을 만들어 보고 싶다</h3><p>산책하며 찍은 사진을 모아보자. 무광 용지와 제본 방식을 비교하고, 주말에 표지 아이디어를 적어보기.</p><span class="note-source">연결은 나중에: 사진집 프로젝트 · 사진 주제</span></div>}</div></section>)}
    <section class="feature-chapter" id="folders"><div class="chapter-intro"><span class="eyebrow">자료와 학습 도구</span><h2>배운 것과 읽은 것도,<br />내 기록의 일부.</h2><p>공부와 강의 기록은 RAVIL을 활용하는 한 방법입니다. Mac에서 개발한 자료·학습 도구도 계속 다듬고 있어요.</p></div><div class="chapter-side"><ul class="feature-bullets"><li id="recording">녹음·가져온 오디오의 전사와 시간 정보</li><li id="versions">PDF의 이전 판본과 변경 이력 보존</li><li id="notes">자료를 읽으며 남긴 노트와 원문 검색</li><li id="review">시험 범위와 출처가 연결된 복습 카드</li></ul><p class="feature-note">긴 녹음·손글씨 인식·학습 결과 생성의 품질과 실제 기기 사용은 각각 검증합니다.</p></div></section>
    <section class="feature-chapter feature-chapter-wide" id="ocr"><div class="chapter-intro"><span class="eyebrow">원문 확인 예제</span><h2>인식한 글도,<br />원문과 함께.</h2><p>아래는 미리 준비한 인식문을 대조하는 설명용 예제입니다. 실제 OCR이나 AI 판정을 실행하지 않으며, 수정한 예제 문장은 새로고침하면 초기화됩니다.</p></div><OCRExample /></section>
    <div class="feature-page-end"><div><h2>먼저, 기록 하나부터.</h2><p>생각나는 내용을 남기고 필요할 때 AI 도움을 요청해 보세요.</p></div><a class="button" href="/login/">내 기록 시작하기<Icon name="arrow" size={17}/></a></div>
  </div>
</Layout>
