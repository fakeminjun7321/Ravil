{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ravil-website",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-05",
  "services": [{"binding":"WORKSPACE_API", "service":"ravil-workspace-preview"}],
  "env": {
    "preview": {
      "services": [{"binding":"WORKSPACE_API", "service":"ravil-workspace-preview"}]
    }
  }
}
